@model CustomerManagementPractiseCS.ViewModels.UserDeleteViewModel

<p class="mb-1">Are you sure you want to delete this account?</p>
<p class="fw-semibold mb-3">@Model.Email</p>

<dl class="row mb-0">
    <dt class="col-sm-3">Roles</dt>
    <dd class="col-sm-9">@(Model.Roles.Count == 0 ? "None" : string.Join(", ", Model.Roles))</dd>

    <dt class="col-sm-3">Profiles</dt>
    <dd class="col-sm-9">@Model.ProfileCount</dd>
</dl>

@if (Model.ProfileCount > 0)
{
    <div class="alert alert-warning mb-0">
        This also deletes <strong>@Model.ProfileCount</strong> profile record(s)
        and any associated photos. This cannot be undone.
    </div>
}
