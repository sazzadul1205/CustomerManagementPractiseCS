@model List<CustomerManagementPractiseCS.ViewModels.UserManagementViewModels.UserListItemViewModel>

@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Users</h1>
    <span class="text-muted">@Model.Count account(s)</span>
</div>

@* The table is loaded from UserManagement/List, this is the first render of it *@
<div class="card shadow-sm">
    <div id="users-container">
        @await Html.PartialAsync("_UserList", Model)
    </div>
</div>

@* Confirmation modal. The Delete button above only fills this in, nothing is deleted yet *@
<div class="modal fade" id="userDeleteModal" tabindex="-1" aria-labelledby="userDeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <form id="userDeleteForm" method="post" asp-action="Delete">
                @* Remembers which user is about to be deleted *@
                <input type="hidden" id="DeleteUserId" />

                <div class="modal-header">
                    <h5 class="modal-title" id="userDeleteModalLabel">Delete user</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body" id="userDeleteModalBody">
                    <p class="text-muted mb-0">Loading…</p>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger" id="userDeleteConfirmButton">
                        Yes, delete
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Reload the users table from the server
        function fetchUsers() {
            $('#users-container').html('<p class="text-muted mb-0 p-3">Loading users...</p>');

            $.get('@Url.Action("List", "UserManagement")')
                .done(function (html) {
                    $('#users-container').html(html);
                })
                .fail(function () {
                    $('#users-container').html('<p class="text-danger mb-0 p-3">Failed to load users.</p>');
                });
        }

        // Open the confirmation modal and fill it with this user's details
        $(document).on('click', '[data-user-delete-id]', function () {
            // Read the id off the clicked button
            const userId = $(this).data('user-delete-id');

            // Remember which user the modal is about, the form posts this id back
            $('#DeleteUserId').val(userId);

            $('#userDeleteModalBody').html('<p class="text-muted mb-0">Loading…</p>');

            // Ask the server for the confirmation details only, this deletes nothing
            $.get('@Url.Action("Delete", "UserManagement")', { id: userId })
                .done(function (html) {
                    $('#userDeleteModalBody').html(html);
                })
                .fail(function () {
                    $('#userDeleteModalBody').html('<p class="text-danger mb-0">Failed to load.</p>');
                });

            bootstrap.Modal.getOrCreateInstance(document.getElementById('userDeleteModal')).show();
        });

        // Delete only after the confirmation above was accepted
        $('#userDeleteForm').on('submit', function (e) {
            e.preventDefault();

            const id = $('#DeleteUserId').val();
            const confirmButton = $('#userDeleteConfirmButton');

            // Stop a double click from sending the delete twice
            confirmButton.prop('disabled', true);

            $.post('@Url.Action("Delete", "UserManagement")', { id: id })
                .done(function (response) {
                    bootstrap.Modal.getInstance(document.getElementById('userDeleteModal')).hide();
                    fetchUsers();
                    showToast(response.message);
                })
                .fail(function () {
                    showToast('The user could not be deleted. Please try again.', true);
                })
                .always(function () {
                    confirmButton.prop('disabled', false);
                });
        });
    </script>
}
