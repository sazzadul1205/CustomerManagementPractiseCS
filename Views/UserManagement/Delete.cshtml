@model CustomerManagementPractiseCS.ViewModels.UserDeleteViewModel

@{
    ViewData["Title"] = "Delete User";
}

<h1>Delete User</h1>

<h3>Are you sure you want to delete this user?</h3>

<div>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Model.Email</dd>

        <dt class="col-sm-2">Roles</dt>
        <dd class="col-sm-10">@string.Join(", ", Model.Roles)</dd>

        <dt class="col-sm-2">Profiles</dt>
        <dd class="col-sm-10">@Model.ProfileCount</dd>
    </dl>

    @if (Model.ProfileCount > 0)
    {
        <div class="alert alert-warning">
            This will also delete <strong>@Model.ProfileCount</strong> profile record(s)
            and any associated photos. This cannot be undone.
        </div>
    }

    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>

    </form>
</div>