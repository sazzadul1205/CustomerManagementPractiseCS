@model CustomerManagementPractiseCS.ViewModels.AddressViewModels.AddressDeleteViewModel

@{
    ViewData["Title"] = "Delete Address";
}

<h1 class="mb-4">Delete Address</h1>

<div class="row">
    <div class="col-md-8">

        <div class="alert alert-danger">
            Are you sure you want to delete this address? This action cannot be undone.
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="mb-2">
                    @Model.AddressType
                    @if (Model.IsPrimary)
                    {
                        <span class="badge bg-primary">Primary</span>
                    }
                </h5>

                <p class="mb-0">
                    @Model.Line1<br />
                    @Model.City@(string.IsNullOrEmpty(Model.State) ? "" : ", " + Model.State)
                    @(string.IsNullOrEmpty(Model.PostalCode) ? "" : " - " + Model.PostalCode)<br />
                    @Model.Country
                </p>
            </div>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Yes, Delete</button>
                <a asp-controller="Profile" asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>

    </div>
</div>