@model CustomerManagementPractiseCS.ViewModels.AddressViewModels.AddressEditViewModel

<form id="addressEditForm">

    <input asp-for="Id" type="hidden" id="EditId" />

    <div class="mb-3">
        <label asp-for="AddressType" class="form-label"></label>
        <select asp-for="AddressType" id="EditAddressType" class="form-select">
            <option value="">-- Select Type --</option>
            <option value="Present">Present</option>
            <option value="Permanent">Permanent</option>
            <option value="Other">Other</option>
        </select>
        <span asp-validation-for="AddressType" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Line1" class="form-label"></label>
        <input asp-for="Line1" id="EditLine1" class="form-control" />
        <span asp-validation-for="Line1" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="City" class="form-label"></label>
            <input asp-for="City" id="EditCity" class="form-control" />
            <span asp-validation-for="City" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="State" class="form-label"></label>
            <input asp-for="State" id="EditState" class="form-control" />
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="PostalCode" class="form-label"></label>
            <input asp-for="PostalCode" id="EditPostalCode" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Country" class="form-label"></label>
            <input asp-for="Country" id="EditCountry" class="form-control" />
            <span asp-validation-for="Country" class="text-danger"></span>
        </div>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsPrimary" id="EditIsPrimary" class="form-check-input" />
        <label asp-for="IsPrimary" class="form-check-label">Mark as primary address</label>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Changes</button>
    </div>

</form>