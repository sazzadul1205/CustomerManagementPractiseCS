@model CustomerManagementPractiseCS.ViewModels.ContactViewModels.ContactEditViewModel

<form id="contactEditForm">

    <input asp-for="Id" type="hidden" id="EditContactId" />

    <div class="mb-3">
        <label asp-for="ContactType" class="form-label"></label>
        <select asp-for="ContactType" id="EditContactType" class="form-select">
            <option value="">-- Select Type --</option>
            <option value="Phone">Phone</option>
            <option value="Email">Email</option>
            <option value="Other">Other</option>
        </select>
        <span asp-validation-for="ContactType" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Label" class="form-label"></label>
        <select asp-for="Label" id="EditLabel" class="form-select">
            <option value="">-- Select Label --</option>
            <option value="Personal">Personal</option>
            <option value="Family">Family</option>
            <option value="Work">Work</option>
        </select>
        <span asp-validation-for="Label" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Value" class="form-label"></label>
        <input asp-for="Value" id="EditValue" class="form-control" />
        <span asp-validation-for="Value" class="text-danger"></span>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsPrimary" id="EditContactIsPrimary" class="form-check-input" />
        <label asp-for="IsPrimary" class="form-check-label">Mark as primary contact</label>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Changes</button>
    </div>

</form>