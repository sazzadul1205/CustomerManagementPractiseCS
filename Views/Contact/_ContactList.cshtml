@model List<CustomerManagementPractiseCS.Models.Contact>

@if (!Model.Any())
{
    <p class="text-muted mb-0">No contacts added yet.</p>
}
else
{
    foreach (var c in Model)
    {
        <div class="d-flex justify-content-between border-bottom py-2">
            <div>
                <strong>@c.ContactType</strong>
                @if (!string.IsNullOrEmpty(c.Label))
                {
                    <span class="text-muted">· @c.Label</span>
                }
                @if (c.IsPrimary)
                {
                    <span class="badge bg-primary">Primary</span>
                }
                <br />
                <small>@c.Value</small>
            </div>
            <div class="d-flex gap-2 align-items-start">
                <button type="button" class="btn btn-sm btn-outline-primary" data-contact-id="@c.Id">
                    Edit
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger" data-contact-delete-id="@c.Id">
                    Delete
                </button>
            </div>
        </div>
    }
}