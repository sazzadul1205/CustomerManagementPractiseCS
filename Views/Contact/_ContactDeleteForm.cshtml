@model CustomerManagementPractiseCS.ViewModels.ContactViewModels.ContactDeleteViewModel

<form id="contactDeleteForm">

    <input asp-for="Id" type="hidden" id="DeleteContactId" />

    <div class="alert alert-danger">
        Are you sure you want to delete this contact? This action cannot be undone.
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <h5 class="mb-2">
                @Model.ContactType · @Model.Label
                @if (Model.IsPrimary)
                {
                    <span class="badge bg-primary">Primary</span>
                }
            </h5>
            <p class="mb-0">@Model.Value</p>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
    </div>

</form>