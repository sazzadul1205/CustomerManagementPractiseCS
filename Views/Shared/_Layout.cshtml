<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Customer Management System</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CustomerManagementPractiseCS.styles.css" asp-append-version="true" />
</head>

<body>

    @* Get the Current Controller and Actions for Active Indicator *@
    @{
        var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
    }

    <!-- Navigation -->
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm mb-4">

            <div class="container">

                <!-- Brand -->
                <a class="navbar-brand fw-semibold" asp-area="" asp-controller="Home" asp-action="Index">
                    Profile Management System
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <!-- Main Navigation -->
                    <ul class="navbar-nav me-auto">

                        @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">

                                <a class="nav-link @(currentController == "Admin" ? "active" : "")" asp-controller="Admin"
                                   asp-action="Index">
                                    Profiles
                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link @(currentController == "UserManagement" ? "active" : "")"
                                   asp-controller="UserManagement" asp-action="Index">
                                    Users
                                </a>

                            </li>
                        }
                        else if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">

                                <a class="nav-link @(currentController == "Profile" ? "active" : "")"
                                   asp-controller="Profile" asp-action="Index">
                                    My Profile
                                </a>

                            </li>
                        }

                    </ul>

                    <!-- Account Navigation -->
                    <ul class="navbar-nav">

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">

                                <span class="nav-link text-muted">
                                    @User.Identity.Name
                                </span>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link @(currentController == "Account" && currentAction == "Profile" ? "active" : "")"
                                   asp-controller="Account" asp-action="Profile">
                                    My Account
                                </a>

                            </li>

                            <li class="nav-item">

                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex">

                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        Logout
                                    </button>

                                </form>

                            </li>
                        }
                        else
                        {
                            <li class="nav-item">

                                <a class="btn btn-outline-primary btn-sm" asp-controller="Account" asp-action="Login">
                                    Login
                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">
                                    Register
                                </a>

                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @* We are Getting the Temp data because of the ASP.NET MVC Automatically is providing the TempData *@
    @if (TempData["Success"] != null)
    {
        <div class="container mt-3">

            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">

                @TempData["Success"]

                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">
                </button>

            </div>

        </div>
    }

    <!-- Page Content -->
    <div class="container">

        <main role="main" class="pb-4">
            @RenderBody()
        </main>

    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>

            // Auto-dismiss any alert marked data-auto-dismiss after 4 seconds
            setTimeout(function () {

                document.querySelectorAll('.alert-dismissible').forEach(function (el) {

                    var alert = bootstrap.Alert.getOrCreateInstance(el);

                    alert.close();

                });

            }, 4000);

    </script>

</body>

</html>