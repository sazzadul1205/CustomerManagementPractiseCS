@model List<CustomerManagementPractiseCS.Models.Education>

@if (!Model.Any())
{
    <p class="text-muted mb-0">No education added yet.</p>
}
else
{
    foreach (var edu in Model)
    {
        <div class="d-flex justify-content-between border-bottom py-2">
            <div>
                <strong>@edu.DegreeLevel — @edu.DegreeName</strong>
                <br />
                <small>
                    @edu.InstitutionName · @edu.StartYear
                    @if (edu.IsOngoing)
                    {
                        <span> - Ongoing</span>
                    }
                    else if (edu.EndYear.HasValue)
                    {
                        <span> - @edu.EndYear</span>
                    }
                </small>
            </div>
            <div class="d-flex gap-2 align-items-start">
                <button type="button" class="btn btn-sm btn-outline-primary" data-education-id="@edu.Id">
                    Edit
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger" data-education-delete-id="@edu.Id">
                    Delete
                </button>
            </div>
        </div>
    }
}