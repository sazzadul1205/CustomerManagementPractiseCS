@model CustomerManagementPractiseCS.ViewModels.EducationViewModels.EducationEditViewModel

<form id="educationEditForm">

    <input asp-for="Id" type="hidden" id="EditEducationId" />

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="DegreeLevel" class="form-label"></label>
            <select asp-for="DegreeLevel" id="EditDegreeLevel" class="form-select">
                <option value="">-- Select Level --</option>
                <option value="SSC">SSC</option>
                <option value="HSC">HSC</option>
                <option value="Diploma">Diploma</option>
                <option value="Bachelor">Bachelor</option>
                <option value="Master">Master</option>
                <option value="PhD">PhD</option>
                <option value="Other">Other</option>
            </select>
            <span asp-validation-for="DegreeLevel" class="text-danger"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label asp-for="DegreeName" class="form-label"></label>
            <input asp-for="DegreeName" id="EditDegreeName" class="form-control" />
            <span asp-validation-for="DegreeName" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="InstitutionName" class="form-label"></label>
        <input asp-for="InstitutionName" id="EditInstitutionName" class="form-control" />
        <span asp-validation-for="InstitutionName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="BoardOrUniversity" class="form-label"></label>
        <input asp-for="BoardOrUniversity" id="EditBoardOrUniversity" class="form-control" />
        <span asp-validation-for="BoardOrUniversity" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="StartYear" class="form-label"></label>
            <input asp-for="StartYear" id="EditStartYear" type="number" class="form-control" />
            <span asp-validation-for="StartYear" class="text-danger"></span>
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="EndYear" class="form-label"></label>
            <input asp-for="EndYear" id="EditEndYear" type="number" class="form-control" />
            <span asp-validation-for="EndYear" class="text-danger"></span>
        </div>

        <div class="col-md-4 mb-3 d-flex align-items-center">
            <div class="form-check mt-4">
                <input asp-for="IsOngoing" id="EditIsOngoing" class="form-check-input" />
                <label asp-for="IsOngoing" class="form-check-label">Currently Ongoing</label>
            </div>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Result" class="form-label"></label>
        <input asp-for="Result" id="EditResult" class="form-control" placeholder="e.g. 3.75 or A+" />
        <span asp-validation-for="Result" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Changes</button>
    </div>

</form>