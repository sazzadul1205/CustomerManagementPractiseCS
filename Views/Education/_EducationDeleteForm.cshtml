@model CustomerManagementPractiseCS.ViewModels.EducationViewModels.EducationDeleteViewModel

<form id="educationDeleteForm">

    <input asp-for="Id" type="hidden" id="DeleteEducationId" />

    <div class="alert alert-danger">
        Are you sure you want to delete this education entry? This action cannot be undone.
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <h5 class="mb-1">
                @Model.DegreeLevel · @Model.DegreeName
                @if (Model.IsOngoing)
                {
                    <span class="badge bg-primary">Ongoing</span>
                }
            </h5>
            <p class="mb-0">
                @Model.InstitutionName<br />
                @Model.StartYear
                @if (Model.IsOngoing)
                {
                    <span> - Ongoing</span>
                }
                else if (Model.EndYear.HasValue)
                {
                    <span> - @Model.EndYear</span>
                }
            </p>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
    </div>

</form>