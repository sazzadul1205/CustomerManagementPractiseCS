@model CustomerManagementPractiseCS.ViewModels.Profile.ProfileEditViewModel

@{
    ViewData["Title"] = "Edit Profile";

    // Today in the format the HTML date input understands (yyyy-MM-dd).
    var maxDate = DateTime.Today.ToString("yyyy-MM-dd");
}

<h1 class="mb-4">Edit Profile</h1>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">

                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- Full Name -->
                    <div class="mb-3">
                        <label class="form-label">Full Name</label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <!-- Gender and Date of Birth -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Gender</label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">-- Select Gender --</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                            <span asp-validation-for="Gender" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Date of Birth</label>
                            <input asp-for="DateOfBirth" type="date" class="form-control"
                                   max="@maxDate" />
                            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Religion and Blood Group -->
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Religion</label>
                            <input asp-for="Religion" class="form-control" />
                            <span asp-validation-for="Religion" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Blood Group</label>
                            <select asp-for="BloodGroup" class="form-select">
                                <option value="">-- Select Blood Group --</option>
                                <option value="A+">A+</option>
                                <option value="A-">A-</option>
                                <option value="B+">B+</option>
                                <option value="B-">B-</option>
                                <option value="AB+">AB+</option>
                                <option value="AB-">AB-</option>
                                <option value="O+">O+</option>
                                <option value="O-">O-</option>
                            </select>
                            <span asp-validation-for="BloodGroup" class="text-danger"></span>
                        </div>
                    </div>

                    <!-- Profile Photo -->
                    <div class="mb-3">
                        <label class="form-label">Profile Photo</label>

                        @if (!string.IsNullOrEmpty(Model.CurrentPhotoUrl))
                        {
                            <div class="mb-2">
                                <img src="@Model.CurrentPhotoUrl" alt="Current photo"
                                     style="max-width:120px; max-height:120px; border-radius:8px;" />
                            </div>
                        }

                        <input asp-for="PhotoFile" type="file" accept=".jpg,.jpeg,.png,.gif,.webp"
                               class="form-control" />
                        <small class="text-muted">Leave empty to keep the current photo.</small>
                    </div>

                    <!-- Summary -->
                    <div class="mb-3">
                        <label class="form-label">About Me</label>
                        <textarea asp-for="Summary" class="form-control" rows="5"></textarea>
                        <span asp-validation-for="Summary" class="text-danger"></span>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}