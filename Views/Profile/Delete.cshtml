@model CustomerManagementPractiseCS.ViewModels.Profile.ProfileDeleteViewModel

@{
    ViewData["Title"] = "Delete Profile";
}

<h1 class="mb-4">Delete Profile</h1>

<div class="row">
    <div class="col-md-8">
        <div class="alert alert-danger">
            Are you sure you want to delete this profile? This action cannot be undone.
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h3 class="mb-1">@Model.FullName</h3>
                <p class="text-muted mb-3">
                    @Model.Gender / @Model.DateOfBirth.ToString("dd MMM yyyy")
                </p>

                @if (!string.IsNullOrEmpty(Model.BloodGroup))
                {
                    <p class="mb-2"><strong>Blood Group:</strong> @Model.BloodGroup</p>
                }

                @if (!string.IsNullOrEmpty(Model.Religion))
                {
                    <p class="mb-2"><strong>Religion:</strong> @Model.Religion</p>
                }

                @if (!string.IsNullOrEmpty(Model.Summary))
                {
                    <hr />
                    <p class="mb-0">@Model.Summary</p>
                }
            </div>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Yes, Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>