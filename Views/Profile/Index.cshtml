        @* Social Link Create Modal *@
        <div class="modal fade" id="socialLinkCreateModal">
            <div class="modal-dialog">
                <div class="modal-content">

                    @* Header *@
                    <div class="modal-header">
                        <h5 class="modal-title">Add Social Link</h5>

                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    @* Body *@
                    <div class="modal-body">
                        <partial name="~/Views/SocialLink/_SocialLinkCreateForm.cshtml"
                                 model="new CustomerManagementPractiseCS.ViewModels.SocialLinkViewModels.SocialLinkCreateViewModel()" />
                    </div>

                </div>
            </div>
        </div>

        @* Social Link Edit Modal *@
        <div class="modal fade" id="socialLinkEditModal">
            <div class="modal-dialog">
