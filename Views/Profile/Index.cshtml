@model CustomerManagementPractiseCS.ViewModels.Profile.ProfileIndexViewModel?

@{
    ViewData["Title"] = "My Profile";
}

@* Header *@
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">My Profile</h1>

    @if (Model == null)
    {
        <a asp-action="Create" class="btn btn-primary">Create Profile</a>
    }
    else
    {
        <div class="d-flex gap-2">
            <a asp-action="Cv" asp-route-id="@Model.Id" class="btn btn-outline-secondary" target="_blank">View CV</a>
            <a asp-action="Edit" class="btn btn-primary">Edit Profile</a>
            <a asp-action="Delete" class="btn btn-danger">Delete Profile</a>
        </div>
    }
</div>

@* Content *@
@if (Model == null)
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <p class="text-muted mb-3">No profile has been created yet.</p>
            <a asp-action="Create" class="btn btn-primary">Create My Profile</a>
        </div>
    </div>
}
else
{
    <div class="row">
        @* Main Content *@
        <div class="col-md-8">

            @* Profile Photo *@
            <div class="text-center mb-3">
                @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                {
                    <img src="@Model.PhotoUrl" alt="@Model.FullName" class="avatar" />
                }
                else
                {
                    <div class="avatar-placeholder">
                        <span class="text-muted">No Photo</span>
                    </div>
                }
            </div>

            @* Basic Info *@
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h3 class="mb-1">@Model.FullName</h3>
                    <p class="text-muted mb-3">
                        @Model.Gender / @Model.DateOfBirth.ToString("dd MMM yyyy")
                    </p>

                    @if (!string.IsNullOrEmpty(Model.BloodGroup))
                    {
                        <p class="mb-2"><strong>Blood Group:</strong> @Model.BloodGroup</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.Religion))
                    {
                        <p class="mb-2"><strong>Religion:</strong> @Model.Religion</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.Summary))
                    {
                        <hr />
                        <p class="mb-0">@Model.Summary</p>
                    }
                </div>
            </div>

            @* Addresses *@
            @* <partial name="_Addresses" model="Model" />*@

            @* Addresses - loaded via axios from AddressController.List *@
            <div class="card shadow-sm mb-3" id="addresses-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Addresses</strong>
                    @* <a asp-controller="Address" asp-action="Create" class="btn btn-sm btn-primary">+ Add</a> *@
                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal"
                            data-bs-target="#addressCreateModal">
                        + Add
                    </button>
                </div>

                <div class="card-body" id="addresses-container"></div>
            </div>

            @* Contacts *@
            @*<partial name="_Contacts" model="Model" />*@

            @* Contacts - loaded via axios from ContactController.List *@
            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Contacts</strong>
                    @* <a asp-controller="Contact" asp-action="Create" class="btn btn-sm btn-primary">+ Add</a> *@
                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal"
                            data-bs-target="#contactCreateModal">
                        + Add
                    </button>
                </div>

                <div class="card-body" id="contacts-container"></div>
            </div>

            @* Education *@
            @*<partial name="_Educations" model="Model" />*@

            @* Education - loaded via axios from EducationController.List *@
            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Education</strong>
                    @* <a asp-controller="Education" asp-action="Create" class="btn btn-sm btn-primary">+ Add</a> *@
                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal"
                            data-bs-target="#educationCreateModal">
                        + Add
                    </button>
                </div>

                <div class="card-body" id="education-container"></div>
            </div>

            @* Experience *@
            @* <a asp-controller="Experience" asp-action="Create" class="btn btn-sm btn-primary">+ Add</a> *@

            @* Experience - loaded via axios from ExperienceController.List *@
            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Experience</strong>
                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal"
                            data-bs-target="#experienceCreateModal">
                        + Add
                    </button>
                </div>
                <div class="card-body" id="experience-container"></div>
            </div>

            @* Social Links *@
            @* <a asp-controller="SocialLink" asp-action="Create" class="btn btn-sm btn-primary">+ Add</a> *@

            @* Social Links - loaded via axios from SocialLinkController.List *@
            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Social Links</strong>
                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal"
                            data-bs-target="#socialLinkCreateModal">
                        + Add
                    </button>
                </div>
                <div class="card-body" id="social-link-container"></div>
            </div>

        </div>

        @* Completeness card in the sidebar so it stays visible without scrolling *@
        <div class="col-md-4">
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h5 class="card-title mb-2">@Model.CompletenessLabel</h5>

                    <div class="progress mb-2" role="progressbar" aria-label="Profile completeness"
                         aria-valuenow="@Model.CompletenessPercentage" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" style="width: @Model.CompletenessPercentage%">
                            @Model.CompletenessPercentage%
                        </div>
                    </div>

                    <p class="text-muted mb-2">
                        @Model.CompletedSections of @Model.TotalSections sections filled in
                    </p>

                    @if (Model.IsProfileComplete)
                    {
                        <p class="text-success mb-0">Your profile is complete.</p>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Keep going — add the missing sections on the left.</p>
                    }
                </div>
            </div>
        </div>

        @* Models - Contact Create Model *@
        <div class="modal fade" id="contactCreateModal">
            <div class="modal-dialog">
                <div class="modal-content">
                
                    @* Header *@
                    <div class="modal-header">
                        <h5 class="modal-title">Add Contact</h5>
        
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
        
                    @* Body *@
                    <div class="modal-body">
                        <partial name="~/Views/Contact/_ContactCreateForm.cshtml"
                                 model="new CustomerManagementPractiseCS.ViewModels.ContactViewModels.ContactCreateViewModel()" />
                    </div>
        
                </div>
            </div>
        </div>

        @* Contact Edit Modal *@
        <div class="modal fade" id="contactEditModal">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Edit Contact</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body" id="contactEditModalBody"></div>
                </div>
            </div>
        </div>

        @* Contact Delete Modal *@
        <div class="modal fade" id="contactDeleteModal">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Delete Contact</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body" id="contactDeleteModalBody"></div>
                </div>
            </div>
        </div>

        @* Education Create Modal *@
        <div class="modal fade" id="educationCreateModal">
            <div class="modal-dialog">
                <div class="modal-content">

                    @* Header *@
                    <div class="modal-header">
                        <h5 class="modal-title">Add Education</h5>

                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    @* Body *@
                    <div class="modal-body">
                        <partial name="~/Views/Education/_EducationCreateForm.cshtml"
                                 model="new CustomerManagementPractiseCS.ViewModels.EducationViewModels.EducationCreateViewModel()" />
                    </div>

                </div>
            </div>
        </div>

        @* Education Edit Modal *@
        <div class="modal fade" id="educationEditModal">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Edit Education</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body" id="educationEditModalBody"></div>
                </div>
            </div>
        </div>

        @* Education Delete Modal *@
        <div class="modal fade" id="educationDeleteModal">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Delete Education</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body" id="educationDeleteModalBody"></div>
                </div>
            </div>
        </div>

        @* Experience Create Modal *@
        <div class="modal fade" id="experienceCreateModal">
            <div class="modal-dialog">
                <div class="modal-content">

                    @* Header *@
                    <div class="modal-header">
                        <h5 class="modal-title">Add Experience</h5>

                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    @* Body *@
                    <div class="modal-body">
                        <partial name="~/Views/Experience/_ExperienceCreateForm.cshtml"
                                 model="new CustomerManagementPractiseCS.ViewModels.ExperienceViewModels.ExperienceCreateViewModel()" />
                    </div>

                </div>
            </div>
        </div>

        @* Experience Edit Modal *@
        <div class="modal fade" id="experienceEditModal">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Edit Experience</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body" id="experienceEditModalBody"></div>
                </div>
            </div>
        </div>

        @* Experience Delete Modal *@
        <div class="modal fade" id="experienceDeleteModal">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Delete Experience</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body" id="experienceDeleteModalBody"></div>
