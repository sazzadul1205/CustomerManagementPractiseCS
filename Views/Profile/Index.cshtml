@model CustomerManagementPractiseCS.ViewModels.Profile.ProfileIndexViewModel?

@{
    ViewData["Title"] = "My Profile";
}

@* Header *@
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">My Profile</h1>

    @if (Model == null)
    {
        <a asp-action="Create" class="btn btn-primary">Create Profile</a>
    }
    else
    {
        <div class="d-flex gap-2">
            <a asp-action="Cv" asp-route-id="@Model.Id" class="btn btn-outline-secondary" target="_blank">View CV</a>
            <a asp-action="Edit" class="btn btn-primary">Edit Profile</a>
            <a asp-action="Delete" class="btn btn-danger">Delete Profile</a>
        </div>
    }
</div>

@* Content *@
@if (Model == null)
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <p class="text-muted mb-3">No profile has been created yet.</p>
            <a asp-action="Create" class="btn btn-primary">Create My Profile</a>
        </div>
    </div>
}
else
{
    <div class="row">
        @* Main Content *@
        <div class="col-md-8">

            @* Profile Photo *@
            <div class="text-center mb-3">
                @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                {
                    <img src="@Model.PhotoUrl" alt="@Model.FullName" class="avatar" />
                }
                else
                {
                    <div class="avatar-placeholder">
                        <span class="text-muted">No Photo</span>
                    </div>
                }
            </div>

            @* Basic Info *@
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h3 class="mb-1">@Model.FullName</h3>
                    <p class="text-muted mb-3">
                        @Model.Gender / @Model.DateOfBirth.ToString("dd MMM yyyy")
                    </p>

                    @if (!string.IsNullOrEmpty(Model.BloodGroup))
                    {
                        <p class="mb-2"><strong>Blood Group:</strong> @Model.BloodGroup</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.Religion))
                    {
                        <p class="mb-2"><strong>Religion:</strong> @Model.Religion</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.Summary))
                    {
                        <hr />
                        <p class="mb-0">@Model.Summary</p>
                    }
                </div>
            </div>

            @* Addresses *@
            @* <partial name="_Addresses" model="Model" />*@

            @* Addresses - loaded via axios from AddressController.List *@
            <div class="card shadow-sm mb-3" id="addresses-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Addresses</strong>
                    @* <a asp-controller="Address" asp-action="Create" class="btn btn-sm btn-primary">+ Add</a> *@
                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal"
                            data-bs-target="#addressCreateModal">
                        + Add
                    </button>
                </div>

                <div class="card-body" id="addresses-container"></div>
            </div>

            @* Contacts *@
            @*<partial name="_Contacts" model="Model" />*@

            @* Contacts - loaded via axios from ContactController.List *@
            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Contacts</strong>
                    @* <a asp-controller="Contact" asp-action="Create" class="btn btn-sm btn-primary">+ Add</a> *@
                    <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal"
                            data-bs-target="#contactCreateModal">
                        + Add
                    </button>
                </div>

                <div class="card-body" id="contacts-container"></div>
            </div>

            @* Education *@
            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Education</strong>
                    <a asp-controller="Education" asp-action="Create" class="btn btn-sm btn-primary">+ Add</a>
                </div>
                <div class="card-body">
                    @if (Model.Educations.Count == 0)
                    {
                        <p class="text-muted mb-0">No education added yet.</p>
                    }
                    else
                    {
                        foreach (var edu in Model.Educations)
                        {
                            <div class="d-flex justify-content-between border-bottom py-2">
                                <div>
                                    <strong>@edu.DegreeLevel — @edu.DegreeName</strong>
                                    <br />
                                    <small>
                                        @edu.InstitutionName · @edu.StartYear
                                        @if (edu.IsOngoing)
                                        {
                                            <span> - Ongoing</span>
                                        }
                                        else if (edu.EndYear.HasValue)
                                        {
                                            <span> - @edu.EndYear</span>
                                        }
                                    </small>
                                </div>
                                <div class="d-flex gap-2 align-items-start">
                                    <a asp-controller="Education" asp-action="Edit" asp-route-id="@edu.Id"
                                       class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-controller="Education" asp-action="Delete" asp-route-id="@edu.Id"
                                       class="btn btn-sm btn-outline-danger">Delete</a>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            @* Experience *@
            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Experience</strong>
                    <a asp-controller="Experience" asp-action="Create" class="btn btn-sm btn-primary">+ Add</a>
                </div>
                <div class="card-body">
                    @if (Model.Experiences.Count == 0)
                    {
                        <p class="text-muted mb-0">No experience added yet.</p>
                    }
                    else
                    {
                        foreach (var exp in Model.Experiences)
                        {
                            <div class="d-flex justify-content-between border-bottom py-2">
                                <div>
                                    <strong>@exp.Designation</strong>
                                    <br />
                                    <small>
                                        @exp.CompanyName · @exp.EmploymentType
                                        @if (!string.IsNullOrEmpty(exp.Location))
                                        {
                                            <span> · @exp.Location</span>
                                        }
                                        <br />
                                        @exp.StartDate.ToString("MMM yyyy")
                                        @if (exp.IsCurrent)
                                        {
                                            <span> - Present</span>
                                        }
                                        else if (exp.EndDate.HasValue)
                                        {
                                            <span> - @exp.EndDate.Value.ToString("MMM yyyy")</span>
                                        }
                                    </small>
                                </div>
                                <div class="d-flex gap-2 align-items-start">
                                    <a asp-controller="Experience" asp-action="Edit" asp-route-id="@exp.Id"
                                       class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-controller="Experience" asp-action="Delete" asp-route-id="@exp.Id"
                                       class="btn btn-sm btn-outline-danger">Delete</a>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            @* Social Links *@
            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Social Links</strong>
                    <a asp-controller="SocialLink" asp-action="Create" class="btn btn-sm btn-primary">+ Add</a>
                </div>
                <div class="card-body">
                    @if (Model.SocialLinks.Count == 0)
                    {
                        <p class="text-muted mb-0">No links added yet.</p>
                    }
                    else
                    {
                        foreach (var link in Model.SocialLinks)
                        {
                            <div class="d-flex justify-content-between border-bottom py-2">
                                <div>
                                    <strong>@link.Platform</strong>
                                    <br />
                                    <small>
                                        <a href="@link.Url" target="_blank">@link.Url</a>
                                    </small>
                                </div>
                                <div class="d-flex gap-2 align-items-start">
                                    <a asp-controller="SocialLink" asp-action="Edit" asp-route-id="@link.Id"
                                       class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-controller="SocialLink" asp-action="Delete" asp-route-id="@link.Id"
                                       class="btn btn-sm btn-outline-danger">Delete</a>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

        </div>

        @* Completeness card in the sidebar so it stays visible without scrolling *@
        <div class="col-md-4">
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h5 class="card-title mb-2">@Model.CompletenessLabel</h5>

                    <div class="progress mb-2" role="progressbar" aria-label="Profile completeness"
                         aria-valuenow="@Model.CompletenessPercentage" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" style="width: @Model.CompletenessPercentage%">
                            @Model.CompletenessPercentage%
                        </div>
                    </div>

                    <p class="text-muted mb-2">
                        @Model.CompletedSections of @Model.TotalSections sections filled in
                    </p>

                    @if (Model.IsProfileComplete)
                    {
                        <p class="text-success mb-0">Your profile is complete.</p>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Keep going — add the missing sections on the left.</p>
                    }
                </div>
            </div>
        </div>

        @* Models - Contact Create Model *@
        <div class="modal fade" id="contactCreateModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                
                    @* Header *@
                    <div class="modal-header">
                        <h5 class="modal-title">Add Contact</h5>
        
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
        
                    @* Body *@
                    <div class="modal-body">
                        <partial name="~/Views/Contact/_ContactCreateForm.cshtml"
                                 model="new CustomerManagementPractiseCS.ViewModels.ContactViewModels.ContactCreateViewModel()" />
                    </div>
        
                </div>
            </div>
        </div>

        @* Contact Edit Modal *@
        <div class="modal fade" id="contactEditModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Edit Contact</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body" id="contactEditModalBody"></div>
                </div>
            </div>
        </div>

        @* Contact Delete Modal *@
        <div class="modal fade" id="contactDeleteModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Delete Contact</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body" id="contactDeleteModalBody"></div>
                </div>
            </div>
        </div>


        @* Models - Address Create Model *@
        <div class="modal fade" id="addressCreateModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                
                    @* Header *@
                    <div class="modal-header">
                        <h5 class="modal-title">Add Address</h5>
        
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
        
                    @* Body *@
                    <div class="modal-body">
                        <partial name="~/Views/Address/_AddressCreateForm.cshtml"
                                 model="new CustomerManagementPractiseCS.ViewModels.AddressViewModels.AddressCreateViewModel()" />
                    </div>
        
                </div>
            </div>
        </div>

        @* Address Edit Modal *@
        <div class="modal fade" id="addressEditModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">Edit Address</h5>

                        <button type="button" class="btn-close" data-bs-dismiss="modal">
                        </button>
                    </div>

                    <div class="modal-body" id="addressEditModalBody"></div>

                </div>
            </div>
        </div>

        @* Address Delete Modal *@
        <div class="modal fade" id="addressDeleteModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title">Delete Address</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body" id="addressDeleteModalBody"></div>

                </div>
            </div>
        </div>

    </div>
}


@if (Model != null)
{
    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

        <script>
            // Function to fetch addresses and update the container
            function fetchAddresses() {
                // Get the container element and set its content to a loading message
                $('#addresses-container').html('<p class="text-muted mb-0">Loading addresses...</p>');

                // Send a GET request to the AddressController's List action
                axios.get('@Url.Action("List", "Address")')
                    .then(function (response) {
                        // On success, replace the container's content with the response data
                        $('#addresses-container').html(response.data);
                    })
                    .catch(function (error) {
                        // On error, log the error and show an error message in the container
                        console.error(error);
                        $('#addresses-container').html('<p class="text-danger mb-0">Failed to load addresses.</p>');
                    });
            }

            // Call the fetchAddresses function when the page loads
            fetchAddresses();

            // Submit Address Create form using jQuery
            $('#addressCreateModal').on('submit', function (e) {
                e.preventDefault();

                const addressData = {
                    addressType: $('#AddressType').val(),
                    line1: $('#Line1').val(),
                    city: $('#City').val(),
                    state: $('#State').val(),
                    postalCode: $('#PostalCode').val(),
                    country: $('#Country').val(),
                    isPrimary: $('#IsPrimary').is(':checked')
                };

                // Send POST request
                axios.post('@Url.Action("Create", "Address")', addressData)
                    .then(function (response) {
                        // Close the modal and refresh the address list
                        bootstrap.Modal.getInstance(document.getElementById('addressCreateModal')).hide();
                        fetchAddresses();
                    })
                    .catch(function (error) {
                        console.error('Error submitting address:', error);
                    });
            });

            // Open and populate the Address Edit modal when an edit button is clicked
            $(document).on('click', '[data-address-id]', function () {  // [data-address-id] is the selector for the edit button

                // Get the address ID from the clicked button's data attribute
                const addressId = $(this).data('address-id');

                // Set the modal body to a loading message while fetching the address details
                $('#addressEditModalBody').html('<p class="text-muted mb-0">Loading…</p>');

                axios.get('@Url.Action("Edit", "Address")', { params: { id: addressId } })
                    .then(function (response) {

                        // On success, populate the modal body with the fetched address details
                        $('#addressEditModalBody').html(response.data);

                        // Show the modal after populating it
                        bootstrap.Modal
                            .getOrCreateInstance(document.getElementById('addressEditModal'))
                            .show();
                    })
                    .catch(function (error) {
                        console.error('Error fetching address details:', error);
                        $('#addressEditModalBody').html('<p class="text-danger mb-0">Failed to load.</p>');
                    });
            });

            // Submit Address Edit form using jQuery
            $('#addressEditModal').on('submit', function (e) {
                e.preventDefault();

                // Get values from the forms
                const addressData = {
                    id: parseInt($('#EditId').val(), 10),
                    addressType: $('#EditAddressType').val(),
                    line1: $('#EditLine1').val(),
                    city: $('#EditCity').val(),
                    state: $('#EditState').val(),
                    postalCode: $('#EditPostalCode').val(),
                    country: $('#EditCountry').val(),
                    isPrimary: $('#EditIsPrimary').is(':checked')
                };

                axios.post('@Url.Action("Edit", "Address")', addressData)
                    .then(function () {
                        // Close the modal and refresh the address list after successful edit
                        bootstrap.Modal.getInstance(document.getElementById('addressEditModal')).hide();
                        fetchAddresses();
                    })
                    .catch(function (err) { console.error(err); });
            });

            // Delete Address modal open and populate
            $(document).on('click', '[data-address-delete-id]', function () { // [data-address-delete-id] is the selector for the delete button
            
                // Get the address ID from the clicked button's data attribute
                const addressId = $(this).data('address-delete-id');

                // Set the modal body to a loading message while fetching the address details
                $('#addressDeleteModalBody').html('<p class="text-muted mb-0">Loading…</p>');

                axios.get('@Url.Action("Delete", "Address")', { params: { id: addressId } })
                    .then(function (response) {
                        // On success, populate the modal body with the fetched address details
                        $('#addressDeleteModalBody').html(response.data);

                        // Show the modal after populating it
                        bootstrap.Modal.getOrCreateInstance(document.getElementById('addressDeleteModal')).show();
                    })
                    .catch(function (error) {
                        console.error('Error fetching address details:', error);
                        $('#addressDeleteModalBody').html('<p class="text-danger mb-0">Failed to load.</p>');
                    });
            });

            // Submit Address Delete form using jQuery
            $('#addressDeleteModal').on('submit', function (e) {
                e.preventDefault();

                const id = parseInt($('#DeleteId').val());

                axios.post('@Url.Action("Delete", "Address")', { id: id })
                    .then(function () {
                        // Close the modal and refresh the address list after successful deletion
                        bootstrap.Modal.getInstance(document.getElementById('addressDeleteModal')).hide();
                        fetchAddresses();
                    })
                    .catch(function (error) {
                        console.error('Error deleting address:', error);
                    });
            });
        </script>
        <script>  
            // Function to fetch addresses and update the container
            function fetchContacts() {
                $('#contacts-container').html('<p class="text-muted mb-0">Loading contacts…</p>');

                axios.get('@Url.Action("List", "Contact")')
                    .then(function (response) {
                        $('#contacts-container').html(response.data);
                    })
                    .catch(function (error) {
                        console.error(error);
                        $('#contacts-container').html('<p class="text-danger mb-0">Failed to load contacts.</p>');
                    });
            }

            // Call the fetchContacts function when the page loads
            fetchContacts();

            // Submit Contact Create form using jQuery
            $('#contactCreateModal').on('submit', function (e) {
                e.preventDefault();

                // Get values from the form
                const contactData = {
                    contactType: $('#ContactType').val(),
                    label: $('#Label').val(),
                    value: $('#Value').val(),
                    isPrimary: $('#ContactIsPrimary').is(':checked')
                };

                axios.post('@Url.Action("Create", "Contact")', contactData)
                    .then(function () {
                        bootstrap.Modal.getInstance(document.getElementById('contactCreateModal')).hide();
                        fetchContacts();
                    })
                    .catch(function (error) {
                        console.error('Error submitting contact:', error);
                    });
            });

            // Open and populate the Contact Edit modal when an edit button is clicked
            $(document).on('click', '[data-contact-id]', function () {
                const contactId = $(this).data('contact-id');

                $('#contactEditModalBody').html('<p class="text-muted mb-0">Loading…</p>');

                axios.get('@Url.Action("Edit", "Contact")', { params: { id: contactId } })
                    .then(function (response) {
                        $('#contactEditModalBody').html(response.data);

                        bootstrap.Modal
                            .getOrCreateInstance(document.getElementById('contactEditModal'))
                            .show();
                    })
                    .catch(function (error) {
                        console.error('Error fetching contact details:', error);
                        $('#contactEditModalBody').html('<p class="text-danger mb-0">Failed to load.</p>');
                    });
            });

            // Submit Contact Edit form using jQuery
            $('#contactEditModal').on('submit', function (e) {
                e.preventDefault();

                const contactData = {
                    id: parseInt($('#EditContactId').val(), 10),
                    contactType: $('#EditContactType').val(),
                    label: $('#EditLabel').val(),
                    value: $('#EditValue').val(),
                    isPrimary: $('#EditContactIsPrimary').is(':checked')
                };

                axios.post('@Url.Action("Edit", "Contact")', contactData)
                    .then(function () {
                        bootstrap.Modal.getInstance(document.getElementById('contactEditModal')).hide();
                        fetchContacts();
                    })
                    .catch(function (error) {
                        console.error(error);
                    });
            });

            // Open and populate the Contact Delete modal when a delete button is clicked
            $(document).on('click', '[data-contact-delete-id]', function () {
                const contactId = $(this).data('contact-delete-id');

                $('#contactDeleteModalBody').html('<p class="text-muted mb-0">Loading…</p>');

                axios.get('@Url.Action("Delete", "Contact")', { params: { id: contactId } })
                    .then(function (response) {
                        $('#contactDeleteModalBody').html(response.data);

                        bootstrap.Modal
                            .getOrCreateInstance(document.getElementById('contactDeleteModal'))
                            .show();
                    })
                    .catch(function (error) {
                        console.error('Error fetching contact details:', error);
                        $('#contactDeleteModalBody').html('<p class="text-danger mb-0">Failed to load.</p>');
                    });
            });

            // Submit Contact Delete form using jQuery
            $('#contactDeleteModal').on('submit', function (e) {
                e.preventDefault();

                const id = parseInt($('#DeleteContactId').val(), 10);

                axios.post('@Url.Action("Delete", "Contact")', { id: id })
                    .then(function () {
                        bootstrap.Modal.getInstance(document.getElementById('contactDeleteModal')).hide();
                        fetchContacts();
                    })
                    .catch(function (error) {
                        console.error('Error deleting contact:', error);
                    });
            });
        </script>

