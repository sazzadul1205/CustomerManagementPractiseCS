@model CustomerManagementPractiseCS.ViewModels.Profile.ProfileIndexViewModel?

@{
    ViewData["Title"] = "My Profile";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">My Profile</h1>

    @if (Model == null)
    {
        <a asp-action="Create" class="btn btn-primary">Create Profile</a>
    }
    else
    {
        <div class="d-flex gap-2">
            <a asp-action="Cv" asp-route-id="@Model.Id" class="btn btn-outline-secondary" target="_blank">View CV</a>
            <a asp-action="Edit" class="btn btn-primary">Edit Profile</a>
            <a asp-action="Delete" class="btn btn-danger">Delete Profile</a>
        </div>
    }
</div>

@if (Model == null)
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <p class="text-muted mb-3">No profile has been created yet.</p>
            <a asp-action="Create" class="btn btn-primary">Create My Profile</a>
        </div>
    </div>
}
else
{
    <div class="row">

        <div class="col-md-8">

            <div class="text-center mb-3">
                @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                {
                    <img src="@Model.PhotoUrl" alt="@Model.FullName"
                         style="max-width:150px; max-height:150px;  object-fit:cover;" />
                }
                else
                {
                    <div
                        style="width:150px; height:150px;  background:#e9ecef; display:inline-flex; align-items:center; justify-content:center;">
                        <span class="text-muted">No Photo</span>
                    </div>
                }
            </div>

            @* Basic Info *@
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h3 class="mb-1">@Model.FullName</h3>
                    <p class="text-muted mb-3">
                        @Model.Gender / @Model.DateOfBirth.ToString("dd MMM yyyy")
                    </p>

                    @if (!string.IsNullOrEmpty(Model.BloodGroup))
                    {
                        <p class="mb-2"><strong>Blood Group:</strong> @Model.BloodGroup</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.Religion))
                    {
                        <p class="mb-2"><strong>Religion:</strong> @Model.Religion</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.Summary))
                    {
                        <hr />
                        <p class="mb-0">@Model.Summary</p>
                    }
                </div>
            </div>

            @* Addresses *@
            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Addresses</strong>
                    <a asp-controller="Address" asp-action="Create" class="btn btn-sm btn-primary">+ Add</a>
                </div>
                <div class="card-body">
                    @if (Model.Addresses.Count == 0)
                    {
                        <p class="text-muted mb-0">No addresses added yet.</p>
                    }
                    else
                    {
                        @foreach (var address in Model.Addresses)
                        {
                            <div class="d-flex justify-content-between border-bottom py-2">
                                <div>
                                    <strong>@address.AddressType</strong>
                                    @if (address.IsPrimary)
                                    {
                                        <span class="badge bg-primary">Primary</span>
                                    }
                                    <br />
                                    <small>@address.Line1, @address.City, @address.Country</small>
                                </div>
                                <div class="d-flex gap-2 align-items-start">
                                    <a asp-controller="Address" asp-action="Edit" asp-route-id="@address.Id"
                                       class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-controller="Address" asp-action="Delete" asp-route-id="@address.Id"
                                       class="btn btn-sm btn-outline-danger">Delete</a>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            @* Contacts *@
            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Contacts</strong>
                    <a asp-controller="Contact" asp-action="Create" class="btn btn-sm btn-primary">+ Add</a>
                </div>
                <div class="card-body">
                    @if (Model.Contacts.Count == 0)
                    {
                        <p class="text-muted mb-0">No contacts added yet.</p>
                    }
                    else
                    {
                        foreach (var contact in Model.Contacts)
                        {
                            <div class="d-flex justify-content-between border-bottom py-2">
                                <div>
                                    <strong>@contact.ContactType</strong> · @contact.Label
                                    @if (contact.IsPrimary)
                                    {
                                        <span class="badge bg-primary">Primary</span>
                                    }
                                    <br />
                                    <small>@contact.Value</small>
                                </div>
                                <div class="d-flex gap-2 align-items-start">
                                    <a asp-controller="Contact" asp-action="Edit" asp-route-id="@contact.Id"
                                       class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-controller="Contact" asp-action="Delete" asp-route-id="@contact.Id"
                                       class="btn btn-sm btn-outline-danger">Delete</a>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            @* Education *@
            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Education</strong>
                    <a asp-controller="Education" asp-action="Create" class="btn btn-sm btn-primary">+ Add</a>
                </div>
                <div class="card-body">
                    @if (Model.Educations.Count == 0)
                    {
                        <p class="text-muted mb-0">No education added yet.</p>
                    }
                    else
                    {
                        foreach (var edu in Model.Educations)
                        {
                            <div class="d-flex justify-content-between border-bottom py-2">
                                <div>
                                    <strong>@edu.DegreeLevel — @edu.DegreeName</strong>
                                    <br />
                                    <small>
                                        @edu.InstitutionName · @edu.StartYear
                                        @if (edu.IsOngoing)
                                        {
                                            <span> - Ongoing</span>
                                        }
                                        else if (edu.EndYear.HasValue)
                                        {
                                            <span> - @edu.EndYear</span>
                                        }
                                    </small>
                                </div>
                                <div class="d-flex gap-2 align-items-start">
                                    <a asp-controller="Education" asp-action="Edit" asp-route-id="@edu.Id"
                                       class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-controller="Education" asp-action="Delete" asp-route-id="@edu.Id"
                                       class="btn btn-sm btn-outline-danger">Delete</a>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            @* Experience *@
            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Experience</strong>
                    <a asp-controller="Experience" asp-action="Create" class="btn btn-sm btn-primary">+ Add</a>
                </div>
                <div class="card-body">
                    @if (Model.Experiences.Count == 0)
                    {
                        <p class="text-muted mb-0">No experience added yet.</p>
                    }
                    else
                    {
                        foreach (var exp in Model.Experiences)
                        {
                            <div class="d-flex justify-content-between border-bottom py-2">
                                <div>
                                    <strong>@exp.Designation</strong>
                                    <br />
                                    <small>
                                        @exp.CompanyName · @exp.EmploymentType
                                        @if (!string.IsNullOrEmpty(exp.Location))
                                        {
                                            <span> · @exp.Location</span>
                                        }
                                        <br />
                                        @exp.StartDate.ToString("MMM yyyy")
                                        @if (exp.IsCurrent)
                                        {
                                            <span> - Present</span>
                                        }
                                        else if (exp.EndDate.HasValue)
                                        {
                                            <span> - @exp.EndDate.Value.ToString("MMM yyyy")</span>
                                        }
                                    </small>
                                </div>
                                <div class="d-flex gap-2 align-items-start">
                                    <a asp-controller="Experience" asp-action="Edit" asp-route-id="@exp.Id"
                                       class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-controller="Experience" asp-action="Delete" asp-route-id="@exp.Id"
                                       class="btn btn-sm btn-outline-danger">Delete</a>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            @* Social Links *@
            <div class="card shadow-sm mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <strong>Social Links</strong>
                    <a asp-controller="SocialLink" asp-action="Create" class="btn btn-sm btn-primary">+ Add</a>
                </div>
                <div class="card-body">
                    @if (Model.SocialLinks.Count == 0)
                    {
                        <p class="text-muted mb-0">No links added yet.</p>
                    }
                    else
                    {
                        foreach (var link in Model.SocialLinks)
                        {
                            <div class="d-flex justify-content-between border-bottom py-2">
                                <div>
                                    <strong>@link.Platform</strong>
                                    <br />
                                    <small>
                                        <a href="@link.Url" target="_blank">@link.Url</a>
                                    </small>
                                </div>
                                <div class="d-flex gap-2 align-items-start">
                                    <a asp-controller="SocialLink" asp-action="Edit" asp-route-id="@link.Id"
                                       class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-controller="SocialLink" asp-action="Delete" asp-route-id="@link.Id"
                                       class="btn btn-sm btn-outline-danger">Delete</a>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

        </div>

        @* Completeness card in the sidebar so it stays visible without scrolling *@
        <div class="col-md-4">
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h5 class="card-title mb-2">@Model.CompletenessLabel</h5>

                    <div class="progress mb-2" role="progressbar"
                         aria-label="Profile completeness"
                         aria-valuenow="@Model.CompletenessPercentage"
                         aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" style="width: @Model.CompletenessPercentage%">
                            @Model.CompletenessPercentage%
                        </div>
                    </div>

                    <p class="text-muted mb-2">
                        @Model.CompletedSections of @Model.TotalSections sections filled in
                    </p>

                    @if (Model.IsProfileComplete)
                    {
                        <p class="text-success mb-0">Your profile is complete.</p>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Keep going — add the missing sections on the left.</p>
                    }
                </div>
            </div>
        </div>

    </div>
}