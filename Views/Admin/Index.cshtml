@{
    ViewData["Title"] = "All Profiles";

    // Read the current filter values from the query string so the boxes stay filled
    var search = Context.Request.Query["search"].ToString();
    var gender = Context.Request.Query["gender"].ToString();
    var bloodGroup = Context.Request.Query["bloodGroup"].ToString();

    // The blood groups offered in the filter, the same list the Profile form uses
    var bloodGroups = new[] { "A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-" };
}

<h1 class="mb-4">All Profiles</h1>

@* Filter form. *@
<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form id="profileFilterForm" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label for="search" class="form-label">Search by name</label>
                <input type="text" id="search" name="search" value="@search" class="form-control"
                       placeholder="e.g. John" />
            </div>

            <div class="col-md-3">
                <label for="gender" class="form-label">Gender</label>
                <select id="gender" name="gender" class="form-select">
                    <option value="" selected="@(gender != "Male" && gender != "Female" && gender != "Other")">-- All --</option>
                    <option value="Male" selected="@(gender == "Male")">Male</option>
                    <option value="Female" selected="@(gender == "Female")">Female</option>
                    <option value="Other" selected="@(gender == "Other")">Other</option>
                </select>
            </div>

            <div class="col-md-3">
                <label for="bloodGroup" class="form-label">Blood Group</label>
                <select id="bloodGroup" name="bloodGroup" class="form-select">
                    <option value="" selected="@(string.IsNullOrEmpty(bloodGroup))">-- All --</option>
                    @foreach (var group in bloodGroups)
                    {
                        <option value="@group" selected="@(bloodGroup == group)">@group</option>
                    }
                </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
                <button type="button" class="btn btn-secondary w-100" data-clear-filter>Clear</button>
            </div>
        </form>
    </div>
</div>

@* Table Container  *@
<div id="profiles-container">
    <p class="text-muted mb-0">Loading profiles...</p>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>

    <script>
        // Load the profile list.
        function fetchProfiles(page) {
            $('#profiles-container').html('<p class="text-muted mb-0">Loading profiles...</p>');

            axios.get('@Url.Action("List", "Admin")', {
                params: {
                    search: $('#search').val(),
                    gender: $('#gender').val(),
                    bloodGroup: $('#bloodGroup').val(),
                    page: page
                }
            })
                .then(function (response) {
                    // The server sends back only the table html
                    $('#profiles-container').html(response.data);
                })
                .catch(function (error) {
                    console.error(error);
                    $('#profiles-container').html('<p class="text-danger mb-0">Failed to load profiles.</p>');
                });
        }

        // The Filter button.
        $('#profileFilterForm').on('submit', function (e) {
            e.preventDefault();
            fetchProfiles(1);
        });

        // Clear empties the boxes and shows every profile again
        $(document).on('click', '[data-clear-filter]', function () {
            $('#search').val('');
            $('#gender').val('');
            $('#bloodGroup').val('');
            fetchProfiles(1);
        });

        // data-profile-page holds the page number to load.
        $(document).on('click', '[data-profile-page]', function (e) {
            e.preventDefault();
            fetchProfiles($(this).data('profile-page'));
        });

        // Load the list when the page opens
        $(document).ready(function () {
            fetchProfiles(1);
        });
    </script>
}
