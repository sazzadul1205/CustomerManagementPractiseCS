@model List<CustomerManagementPractiseCS.ViewModels.AdminViewModels.AdminProfileListViewModel>

@{
    ViewData["Title"] = "All Profiles";
    var search = ViewData["Search"] as string;
    var gender = ViewData["Gender"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">All Profiles</h1>
    <span class="text-muted">@Model.Count profile(s)</span>
</div>

<!-- Filter form -->
<div class="card shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label">Search (name or city)</label>
                <input type="text" name="search" value="@search" class="form-control" placeholder="e.g. John or Dhaka" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Gender</label>
                <select name="gender" class="form-select">
                    <option value="">-- All --</option>
                    <option value="Male" selected="@(gender == "Male")">Male</option>
                    <option value="Female" selected="@(gender == "Female")">Female</option>
                    <option value="Other" selected="@(gender == "Other")">Other</option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">Filter</button>
                <a asp-action="Index" class="btn btn-secondary w-100">Clear</a>
            </div>
        </form>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <p class="text-muted mb-0">No profiles match your filter.</p>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:80px;">Photo</th>
                        <th>Name</th>
                        <th>Gender</th>
                        <th>Date of Birth</th>
                        <th>City</th>
                        <th>Blood</th>
                        <th>Religion</th>
                        <th>Created</th>
                        <th style="width:120px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var profile in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(profile.PhotoUrl))
                                {
                                    <img src="@profile.PhotoUrl" alt="@profile.FullName"
                                         style="width:50px; height:50px; border-radius:50%; object-fit:cover;" />
                                }
                                else
                                {
                                    <div style="width:50px; height:50px; border-radius:50%; background:#e9ecef; display:flex; align-items:center; justify-content:center;">
                                        <small class="text-muted">—</small>
                                    </div>
                                }
                            </td>
                            <td><strong>@profile.FullName</strong></td>
                            <td>@profile.Gender</td>
                            <td>@profile.DateOfBirth.ToString("dd MMM yyyy")</td>
                            <td>@(string.IsNullOrEmpty(profile.City) ? "—" : profile.City)</td>
                            <td>@(string.IsNullOrEmpty(profile.BloodGroup) ? "—" : profile.BloodGroup)</td>
                            <td>@(string.IsNullOrEmpty(profile.Religion) ? "—" : profile.Religion)</td>
                            <td>@profile.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@profile.Id" class="btn btn-sm btn-outline-primary">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}