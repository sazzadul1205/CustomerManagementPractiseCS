@model List<CustomerManagementPractiseCS.ViewModels.AdminViewModels.AdminProfileListViewModel>

@{
    // Read the filter values from the query string
    var search = Context.Request.Query["search"].ToString();
    var gender = Context.Request.Query["gender"].ToString();
    var bloodGroup = Context.Request.Query["bloodGroup"].ToString();
    var hasFilter = !string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(gender) || !string.IsNullOrEmpty(bloodGroup);

    // Pagination values
    int currentPage = (int)ViewBag.Page;
    int totalPages = (int)ViewBag.TotalPages;
    int totalCount = (int)ViewBag.Total;
}

@if (Model.Count == 0)
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            @if (hasFilter)
            {
                <p class="text-muted mb-3">No profiles match your filter.</p>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-clear-filter>Clear filter</button>
            }
            else
            {
                <p class="text-muted mb-0">No profiles yet.</p>
            }
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:80px;">Photo</th>
                        <th>Name</th>
                        <th>Gender</th>
                        <th>Date of Birth</th>
                        <th>City</th>
                        <th>Blood</th>
                        <th>Religion</th>
                        <th>Created</th>
                        <th style="width:120px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var profile in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(profile.PhotoUrl))
                                {
                                    <img src="@profile.PhotoUrl" alt="@profile.FullName" class="avatar-sm" />
                                }
                                else
                                {
                                    <div class="avatar-placeholder-sm">
                                        <small class="text-muted">—</small>
                                    </div>
                                }
                            </td>
                            <td>
                                <strong>
                                    @profile.FullName
                                </strong>
                            </td>
                            <td>@profile.Gender</td>
                            <td>@profile.DateOfBirth.ToString("dd MMM yyyy")</td>
                            <td>
                                @(string.IsNullOrEmpty(profile.City) ? "—" : profile.City)
                            </td>
                            <td>
                                @(string.IsNullOrEmpty(profile.BloodGroup) ? "—" : profile.BloodGroup)
                            </td>
                            <td>
                                @(string.IsNullOrEmpty(profile.Religion) ? "—" : profile.Religion)
                            </td>
                            <td>@profile.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@profile.Id"
                                   class="btn btn-sm btn-outline-primary">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-4" aria-label="Profile pages">

            <ul class="pagination justify-content-center mb-2">

                @* Previous *@
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       href="@Url.Action("List", "Admin", new { search = search, gender = gender, bloodGroup = bloodGroup, page = currentPage - 1 })">
                        Previous
                    </a>
                </li>

                @* Available Pages *@
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">

                        <a class="page-link"
                           href="@Url.Action("List", "Admin", new { search = search, gender = gender, bloodGroup = bloodGroup, page = i })">
                            @i
                        </a>

                    </li>
                }

                @* Next *@
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link"
                       href="@Url.Action("List", "Admin", new { search = search, gender = gender, bloodGroup = bloodGroup, page = currentPage + 1 })">
                        Next
                    </a>
                </li>

            </ul>

            <p class="text-center text-muted small mb-0">
                Page @currentPage of @totalPages
            </p>

        </nav>
    }
}
