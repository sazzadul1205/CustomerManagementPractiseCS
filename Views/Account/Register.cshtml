@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h2 class="text-center mb-1">Register</h2>
                <p class="text-center text-muted mb-4">
                    Create your account
                </p>

                <form asp-action="Register" method="post">

                    <div asp-validation-summary="All" class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label">
                            Email
                        </label>

                        <input type="email" id="email" name="email" class="form-control" placeholder="Enter your email"
                               required />
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">
                            Password
                        </label>

                        <input type="password" id="password" name="password" class="form-control"
                               placeholder="Create a password" required />
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        Register
                    </button>

                </form>

                <hr class="my-4" />

                <p class="text-center mb-0">
                    Already have an account?
                    <a asp-action="Login">
                        Login here
                    </a>
                </p>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            //  find the Form element and On Submit Do the thing Inside
            $("form").on("submit", function () {

                // Get the Register button with the Type Submit
                var registerButton = $(this).find("button[type='submit']");

                // Change the Properties To Disable True
                registerButton.prop("disabled", true);

                // Add a Spinner inside
                registerButton.html(
                    '<span class="spinner-border spinner-border-sm me-2"></span>Registering...'
                );
            })
        })
    </script>
}