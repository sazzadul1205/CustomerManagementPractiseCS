@model CustomerManagementPractiseCS.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<h1>My Profile</h1>

<dl class="row">
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Username</dt>
    <dd class="col-sm-9">@Model.UserName</dd>

    <dt class="col-sm-3">Phone Number</dt>
    <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "—" : Model.PhoneNumber)</dd>

    <dt class="col-sm-3">Roles</dt>
    <dd class="col-sm-9">@string.Join(", ", Model.Roles)</dd>
</dl>

<div class="mt-3">
    <a asp-action="EditProfile" class="btn btn-primary">Edit Profile</a>
    <a asp-action="ChangePassword" class="btn btn-warning">Change Password</a>
</div>