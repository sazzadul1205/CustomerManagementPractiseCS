@{
    ViewData["Title"] = "Access Denied";
}

<div class="text-center mt-5">
    <h1 class="display-4 text-danger">Access Denied</h1>
    <p class="lead">You don't have permission to access this page.</p>

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <p class="text-muted">
            Logged in as <strong>@User.Identity.Name</strong>
            (@(User.IsInRole("Admin") ? "Admin" : "User"))
        </p>

        @if (User.IsInRole("Admin"))
        {
            <a asp-controller="Admin" asp-action="Index" class="btn btn-primary">
                Go to Profiles
            </a>
        }
        else
        {
            <a asp-controller="Profile" asp-action="Index" class="btn btn-primary">
                Go to My Profile
            </a>
        }
    }
    else
    {
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary">
            Login
        </a>
    }
</div>