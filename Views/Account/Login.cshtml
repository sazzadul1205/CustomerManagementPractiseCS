@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5 col-lg-4">

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <h2 class="text-center mb-1">Login</h2>
                <p class="text-center text-muted mb-4">
                    Sign in to your account
                </p>

                <form asp-action="Login" method="post">

                    <div asp-validation-summary="All" class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label">
                            Email
                        </label>

                        <input type="email" id="email" name="email" class="form-control" placeholder="Enter your email"
                               required />
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">
                            Password
                        </label>

                        <input type="password" id="password" name="password" class="form-control"
                               placeholder="Enter your password" required />
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        Login
                    </button>

                </form>

                <hr class="my-4" />

                <p class="text-center mb-0">
                    Don't have an account?
                    <a asp-action="Register">
                        Register here
                    </a>
                </p>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            //  find the Form element and On Submit Do the thing Inside
            $("form").on("submit", function () {

                // Get the Login button with the Type Submit  
                var loginButton = $(this).find("button[type='submit']");

                // Change the Properties To Disable True
                loginButton.prop("disabled", true);

                // Add a Spinner inside
                loginButton.html(
                    '<span class="spinner-border spinner-border-sm me-2"></span>Logging in...'
                );
            })
        })
    </script>
}