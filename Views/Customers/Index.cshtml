@model List<CustomerManagementPractiseCS.ViewModels.CustomerActiveDetailsViewModel>
@inject Microsoft.AspNetCore.Identity.UserManager<Microsoft.AspNetCore.Identity.IdentityUser> UserManager

@{
    ViewData["Title"] = "Customers";
    var currentUserId = UserManager.GetUserId(User);
}

<h1>Customers</h1>

@if (!Model.Any())
{
    <p class="text-muted">No customers have been added yet.</p>
}
else
{

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Image</th>
            <th>Name</th>
            <th>Gender</th>
            <th>Bio Data</th>
            <th>Phone</th>
            <th>Email</th>
            <th>City</th>
            <th>Country</th>
              <th>Actions</th> 
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            var customer = item.Customer;
            var detail = item.ActiveDetail;

            <tr>
                <td>
                    @if (detail != null && !string.IsNullOrEmpty(detail.ProfileImage))
                    {
                        <img src="@detail.ProfileImage"
                             alt="@customer.Name"
                             style="width: 45px; height: 45px; object-fit: cover; border-radius: 50%;" />
                    }
                    else
                    {
                        <span style="display: inline-block; width: 45px; height: 45px; border-radius: 50%; background-color: #e0e0e0; border: 1px solid #ccc;"></span>
                    }
                </td>

                <td>@customer.Name</td>
                <td>@customer.Gender</td>
                <td>@customer.BioData</td>

                @if (detail != null)
                {
                    <td>@detail.Phone</td>
                    <td>@detail.Email</td>
                    <td>@detail.City</td>
                    <td>@detail.Country</td>
                }
                else
                {
                    <td colspan="4" class="text-muted fst-italic">
                        No active detail record
                    </td>
                }
                  <td>

                <a asp-controller="Customers"
                   asp-action="Edit"
                   asp-route-id="@customer.Id"
                   class="btn btn-sm btn-warning">
                    Edit
                </a>

                <a asp-controller="Customers"
                   asp-action="Delete"
                   asp-route-id="@customer.Id"
                   class="btn btn-sm btn-danger">
                    Delete
                </a>
            </td>
            </tr>
        }
    </tbody>
</table>
}