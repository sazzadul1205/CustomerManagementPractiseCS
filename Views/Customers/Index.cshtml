@model List<CustomerManagementPractiseCS.ViewModels.CustomerActiveDetailsViewModel>

@{
    ViewData["Title"] = "Customers";
}

<h1 class="mb-4">Customers</h1>

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body">
            <p class="text-muted mb-0">
                No customers have been added yet.
            </p>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body">

            <div class="mb-3">
                <h4 class="mb-1">Customer List</h4>
                <p class="text-muted mb-0">
                    View and manage customers
                </p>
            </div>

            <hr />

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Name</th>
                            <th>Gender</th>
                            <th>Bio Data</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>City</th>
                            <th>Country</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            var customer = item.Customer;
                            var detail = item.ActiveDetail;

                            <tr>

                                <!-- Image -->
                                <td>
                                    @if (detail != null &&
                                         !string.IsNullOrEmpty(detail.ProfileImage))
                                    {
                                        <img src="@detail.ProfileImage"
                                             alt="@customer.Name"
                                             class="img-thumbnail"
                                             style="width: 50px; height: 50px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-light border rounded"
                                             style="width: 50px; height: 50px;">
                                        </div>
                                    }
                                </td>

                                <!-- Customer -->
                                <td>
                                    <strong>@customer.Name</strong>
                                </td>

                                <td>@customer.Gender</td>

                                <td>
                                    @customer.BioData
                                </td>

                                <!-- Active Details -->
                                @if (detail != null)
                                {
                                    <td>@detail.Phone</td>
                                    <td>@detail.Email</td>
                                    <td>@detail.City</td>
                                    <td>@detail.Country</td>
                                }
                                else
                                {
                                    <td colspan="4"
                                        class="text-muted fst-italic">
                                        No active detail record
                                    </td>
                                }

                                <!-- Actions -->
                                <td>
                                    <div class="d-flex gap-1">

                                        <a asp-controller="Customers"
                                           asp-action="Edit"
                                           asp-route-id="@customer.Id"
                                           class="btn btn-sm btn-warning">
                                            Edit
                                        </a>

                                        <a asp-controller="Customers"
                                           asp-action="Delete"
                                           asp-route-id="@customer.Id"
                                           class="btn btn-sm btn-danger">
                                            Delete
                                        </a>

                                    </div>
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>
}
