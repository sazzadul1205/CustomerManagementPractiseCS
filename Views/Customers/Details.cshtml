@model CustomerManagementPractiseCS.Models.Customer

@{
    ViewData["Title"] = "Customer Details";
}

<h1 class="mb-4">Customer Details</h1>

<!-- Customer Information -->
<div class="card shadow-sm mb-4">
    <div class="card-body">

        <div class="mb-3">
            <h4 class="mb-1">@Model.Name</h4>
            <p class="text-muted mb-0">Customer Information</p>
        </div>

        <hr />

        <div class="row">
            <div class="col-md-4 mb-3">
                <strong>Name</strong>
                <div class="text-muted">@Model.Name</div>
            </div>

            <div class="col-md-4 mb-3">
                <strong>Gender</strong>
                <div class="text-muted">@Model.Gender</div>
            </div>

            <div class="col-md-4 mb-3">
                <strong>Customer ID</strong>
                <div class="text-muted">@Model.Id</div>
            </div>

            <div class="col-12">
                <strong>Bio Data</strong>
                <div class="text-muted">
                    @Model.BioData
                </div>
            </div>
        </div>

    </div>
</div>


<!-- Customer Details -->
<div class="card shadow-sm mb-4">
    <div class="card-body">

        <div class="mb-3">
            <h4 class="mb-1">Customer Details</h4>
            <p class="text-muted mb-0">
                Contact and profile information
            </p>
        </div>

        @if (Model.Details != null && Model.Details.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Date of Birth</th>
                            <th>City</th>
                            <th>Country</th>
                            <th>Address</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var detail in Model.Details)
                        {
                            <tr>

                                <!-- Image -->
                                <td>
                                    @if (!string.IsNullOrEmpty(detail.ProfileImage))
                                    {
                                        <img src="@detail.ProfileImage"
                                             alt="Profile"
                                             class="img-thumbnail"
                                             style="width: 60px; height: 60px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <!-- Contact -->
                                <td>@detail.Phone</td>

                                <td>@detail.Email</td>

                                <!-- Date -->
                                <td>
                                    @(detail.DateOfBirth?.ToString("yyyy-MM-dd") ?? "-")
                                </td>

                                <!-- Location -->
                                <td>@detail.City</td>

                                <td>@detail.Country</td>

                                <td>@detail.Address</td>

                                <!-- Status -->
                                <td>
                                    @if (detail.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <!-- Actions -->
                                <td>
                                    <div class="d-flex gap-1">

                                        <a asp-controller="CustomerDetail"
                                           asp-action="Edit"
                                           asp-route-id="@detail.Id"
                                           class="btn btn-sm btn-primary">
                                            Edit
                                        </a>

                                        <a asp-controller="CustomerDetail"
                                           asp-action="Delete"
                                           asp-route-id="@detail.Id"
                                           class="btn btn-sm btn-danger">
                                            Delete
                                        </a>

                                        @if (!detail.IsActive)
                                        {
                                            <form asp-controller="CustomerDetail"
                                                  asp-action="SetActive"
                                                  asp-route-id="@detail.Id"
                                                  method="post">

                                                <button type="submit"
                                                        class="btn btn-sm btn-success">
                                                    Set Active
                                                </button>

                                            </form>
                                        }

                                    </div>
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }
        else
        {
            <div class="py-3">
                <p class="text-muted mb-0">
                    No customer details have been added yet.
                </p>
            </div>
        }

    </div>
</div>


<!-- Page Actions -->
<div class="d-flex gap-2">

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-primary">
        Edit
    </a>

    <a asp-controller="CustomerDetail"
       asp-action="Create"
       asp-route-customerId="@Model.Id"
       class="btn btn-success">
        Add Customer Detail
    </a>

    @if (User.IsInRole("Admin"))
    {
        <a asp-controller="Customers"
           asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>
    }
    else
    {
        <a asp-controller="Customers"
           asp-action="MyData"
           class="btn btn-secondary">
            Back
        </a>
    }

</div>

