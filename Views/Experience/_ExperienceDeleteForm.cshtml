@model CustomerManagementPractiseCS.ViewModels.ExperienceViewModels.ExperienceDeleteViewModel

<form id="experienceDeleteForm">

    <input asp-for="Id" type="hidden" id="DeleteExperienceId" />

    <div class="alert alert-danger">
        Are you sure you want to delete this experience entry? This action cannot be undone.
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <h5 class="mb-1">
                @Model.Designation
                @if (Model.IsCurrent)
                {
                    <span class="badge bg-primary">Current</span>
                }
            </h5>
            <p class="mb-0">
                @Model.CompanyName
                @if (!string.IsNullOrEmpty(Model.Department))
                {
                    <span> · @Model.Department</span>
                }
                <br />
                @Model.EmploymentType
                @if (!string.IsNullOrEmpty(Model.Location))
                {
                    <span> · @Model.Location</span>
                }
                <br />
                @Model.StartDate.ToString("dd MMM yyyy")
                @if (Model.IsCurrent)
                {
                    <span> - Present</span>
                }
                else if (Model.EndDate.HasValue)
                {
                    <span> - @Model.EndDate.Value.ToString("dd MMM yyyy")</span>
                }
            </p>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-danger">Yes, Delete</button>
    </div>

</form>