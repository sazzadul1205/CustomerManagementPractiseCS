@model CustomerManagementPractiseCS.ViewModels.ExperienceViewModels.ExperienceDeleteViewModel

@{
    ViewData["Title"] = "Delete Experience";
}

<h1 class="mb-4">Delete Experience</h1>

<div class="row">
    <div class="col-md-8">

        <div class="alert alert-danger">
            Are you sure you want to delete this experience entry? This action cannot be undone.
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="mb-1">@Model.Designation</h5>
                <p class="text-muted mb-2">
                    @Model.CompanyName
                    @if (!string.IsNullOrEmpty(Model.Department))
                    {
                        <span> · @Model.Department</span>
                    }
                </p>

                <p class="mb-2">
                    <strong>Type:</strong> @Model.EmploymentType
                    @if (!string.IsNullOrEmpty(Model.Location))
                    {
                        <span> · @Model.Location</span>
                    }
                </p>

                <p class="mb-2">
                    <strong>Duration:</strong>
                    @Model.StartDate.ToString("dd MMM yyyy")
                    @if (Model.IsCurrent)
                    {
                        <span> - Present</span>
                    }
                    else if (Model.EndDate.HasValue)
                    {
                        <span> - @Model.EndDate.Value.ToString("dd MMM yyyy")</span>
                    }
                </p>

                @if (!string.IsNullOrEmpty(Model.Responsibilities))
                {
                    <hr />
                    <p class="mb-0">@Model.Responsibilities</p>
                }
            </div>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Yes, Delete</button>
                <a asp-controller="Profile" asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>

    </div>
</div>